# NAS directory paths (adjust to your environment)
DOWNLOADS_DIR=/downloads
MEDIA_DIR=/media
ARCHIVE_FILE_PATH=/media/archive.txt
DB_PATH=/media/yt_manager.db

# MeTube instance URL
METUBE_URL=http://localhost:8081

# Periodic scan configuration (in minutes, set to 0 to disable)
SCAN_INTERVAL_MINUTES=120
AUTO_SCAN_ON_STARTUP=true

# Scan exclusion settings (comma-separated)
# - Without a slash (/): skips any directory with that name anywhere (e.g. backup,temp)
# - With a slash (/): skips only the specified exact/relative path (e.g. /media/private,/media/family)
EXCLUDE_DIRS=backup,temp,/media/family

# File exclusion patterns (glob patterns, comma-separated)
EXCLUDE_PATTERNS=*sample*,test_*,*.temp.mp4

# Telegram bot configuration (optional, starts automatically if token is provided)
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Allowed Telegram user numeric IDs (comma-separated; leave empty for open access)
TELEGRAM_ALLOWED_USERS=
