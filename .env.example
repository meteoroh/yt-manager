# NAS 디렉토리 경로 (실제 환경에 맞게 수정)
DOWNLOADS_DIR=/downloads
MEDIA_DIR=/media
ARCHIVE_FILE_PATH=/media/archive.txt
DB_PATH=/media/yt_manager.db

# MeTube 인스턴스 주소
METUBE_URL=http://localhost:8081

# 주기적 스캔 설정 (분 단위, 0이면 비활성화)
SCAN_INTERVAL_MINUTES=15
AUTO_SCAN_ON_STARTUP=true

# 스캔 제외 설정 (쉼표 구분)
# - 슬래시(/)가 없으면: 해당 폴더명을 가진 모든 폴더 스킵 (예: backup,temp)
# - 슬래시(/)가 있으면: 특정 절대/상대 경로만 스킵 (예: /media/개인,/media/가족)
EXCLUDE_DIRS=backup,temp,/media/가족

# 제외할 파일 패턴 (글롭 패턴, 쉼표 구분)
EXCLUDE_PATTERNS=*sample*,test_*,*.temp.mp4

# 텔레그램 봇 설정 (선택사항, 입력 시 서버 구동 시 자동 시작)
# BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 허용할 텔레그램 사용자 숫자 ID (쉼표 구분, 비워두면 누구나 접근 가능)
TELEGRAM_ALLOWED_USERS=
